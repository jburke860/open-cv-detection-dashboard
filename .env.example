NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional. Google Analytics measurement ID (G-XXXXXXXXXX); analytics only
# runs in production builds.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional. If omitted, createDetectionJob still uploads to Firebase and writes
# the Firestore job record so Cloud Run can be triggered by Firestore instead.
NEXT_PUBLIC_DETECTION_API_URL=
