rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /detectionJobs/{jobId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function ownsExistingJob() {
        return isSignedIn() && resource.data.ownerId == request.auth.uid;
      }

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == "queued";

      allow read: if ownsExistingJob();

      allow update, delete: if ownsExistingJob()
        && request.resource.data.ownerId == resource.data.ownerId;
    }
  }
}
